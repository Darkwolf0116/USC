# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# e2e screenshots
/tests/screenshots/

# Hallmark and design tooling output
/.hallmark/

# tooling state
/.atl/
/.claude/skills/

# personal reference screenshots
/Info/Ejemplo*.png

# local model cache for the RAG index builder
/.cache/

# source drop folder for research-axis PDFs (imported by `npm run axes`)
/Ejes/
